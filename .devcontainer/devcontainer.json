{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "ccb",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Asia/Shanghai}",
      "DNF_MIRROR": "${localEnv:CCB_DNF_MIRROR:}",
      "GEM_MIRROR": "${localEnv:CCB_GEM_MIRROR:}"
    }
  },
  "runArgs": [],
  "init": true,
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "mounts": [
    "source=ccb-history-${devcontainerId},target=/commandhistory,type=volume"
  ],
  "remoteEnv": {
    "ACCOUNT": "${localEnv:CCB_ACCOUNT:}",
    "PASSWORD": "${localEnv:CCB_PASSWORD:}",
    "PUBLIC_KEY_URL": "${localEnv:CCB_PUBLIC_KEY_URL:}",
    "CCB_GATEWAY_IP": "${localEnv:CCB_GATEWAY_IP:}",
    "CCB_GATEWAY_PORT": "${localEnv:CCB_GATEWAY_PORT:}",
    "CCB_REPOSITORIES_HOST": "${localEnv:CCB_REPOSITORIES_HOST:}",
    "CCB_REPOSITORIES_PORT": "${localEnv:CCB_REPOSITORIES_PORT:}",
    "CCB_REPOSITORIES_PROTOCOL": "${localEnv:CCB_REPOSITORIES_PROTOCOL:}",
    "CCB_RESULT_HOST": "${localEnv:CCB_RESULT_HOST:}",
    "CCB_RESULT_PORT": "${localEnv:CCB_RESULT_PORT:}",
    "CCB_RESULT_PROTOCOL": "${localEnv:CCB_RESULT_PROTOCOL:}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash /workspace/.devcontainer/post_install.sh"
}
